# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit the filled version.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server-only: the webhook and the crawler ingest. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (Supabase > Settings > Database > Connection string).
# The webhook needs real transactions, which PostgREST cannot provide.
DATABASE_URL=

# Stripe — TEST MODE ONLY. These are the same variable names Cartello uses, so
# the values from that project's .env can be copied across unchanged.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ids created in the Stripe test dashboard, mapped to tiers in lib/stripe.ts
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...

# Product matching
ANTHROPIC_API_KEY=

# Email — invitations and alert delivery (Cartello uses Resend too)
RESEND_API_KEY=
EMAIL_FROM=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used only by `npm run test:rls`. Points at the throwaway Docker Postgres:
#   docker run -d --name pv-test -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=pricevane -p 55432:5432 postgres:17
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/pricevane
